{
  "global": {
    "files": "/src/**/*.*",
    "noIssues": [
      "zquiet"
    ],
    "exclude": [
      "/legacy/"
    ]
  },
  "syntax": {
    "version": "v757",
    "errorNamespace": "^(Z|Y|LCL_|TY_|LIF_)"
  },
  "rules": {
    "parser_error": true,
    "check_syntax": true
  },
  "dependencies": [
    {
      "folder": "/deps",
      "files": "/src/**/*.*"
    }
  ]
}
